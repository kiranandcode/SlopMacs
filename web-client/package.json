{
  "name": "emacs-web-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "vendor": "mkdir -p public/vendor && cp node_modules/spytial-core/dist/browser/spytial-core-complete.global.js public/vendor/spytial-core.global.js && cp node_modules/spytial-core/dist/browser/spytial-core-complete.css public/vendor/spytial-core.css",
    "predev": "npm run vendor",
    "dev": "vite",
    "prebuild": "npm run vendor",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac dir"
  },
  "dependencies": {
    "js-yaml": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "spytial-core": "^2.9.0",
    "tldraw": "^5.1.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "vite": "^8.0.10"
  },
  "build": {
    "appId": "dev.emacsslop.app",
    "productName": "EmacsSlop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "emacs-root",
        "filter": [
          "src/emacs",
          "src/emacs.pdmp",
          "web-display/emacs-web-display",
          "lisp/**",
          "leim/**",
          "etc/**",
          "info/**",
          "lib-src/**",
          "native-lisp/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "electron/icon.png",
      "target": [
        "dir"
      ]
    }
  }
}
